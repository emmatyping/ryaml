# libFuzzer dictionary of YAML syntax, for -dict=fuzz/yaml.dict.
# Indicators and document markers
"---"
"--- "
"..."
"\x0a---\x0a"
"\x0a...\x0a"
"- "
"? "
": "
":"
","
"["
"]"
"{"
"}"
"[]"
"{}"
"#"
" #"
"|"
">"
"|-"
"|+"
">-"
">+"
"|2"
">1-"
"'"
"\""
"''"
"\\"
"\x09"
"\x0d\x0a"
"\x0d"
# Directives
"%YAML 1.1"
"%YAML 1.2"
"%YAML 2.0"
"%TAG "
"%TAG ! "
"%TAG !! "
"%TAG !e! "
"%FOO "
"tag:yaml.org,2002:"
# Anchors, aliases, tags
"&a "
"*a"
"&a"
"!"
"! "
"!!"
"!e!"
"!<"
"!<tag:yaml.org,2002:str>"
"!<!>"
"!local"
"%21"
# Core tags
"!!str"
"!!int"
"!!float"
"!!bool"
"!!null"
"!!binary"
"!!timestamp"
"!!seq"
"!!map"
"!!omap"
"!!pairs"
"!!set"
"!!merge"
"!!value"
"!!python/"
"!!python/tuple"
# Merge and value keys
"<<"
"<<: "
"<<: *a"
"<<: [*a"
"="
"=: "
# Scalars the resolver recognises
"~"
"null"
"Null"
"NULL"
"true"
"True"
"FALSE"
"yes"
"No"
"on"
"OFF"
"y"
"n"
".inf"
"-.inf"
"+.INF"
".nan"
".NaN"
"0x"
"0o"
"0b"
"0_"
"1_000"
"1:20"
"190:20:30"
"1e3"
"1.5e-10"
"6.8523015e+5"
"-0"
"-0.0"
"0."
"2001-12-14"
"2001-12-14t21:59:43.10-05:00"
"2001-12-14 21:59:43.10 Z"
"2002-12-14T01:02:03Z"
"+05:30"
"R0lGODlh"
"=="
# Escapes
"\\x"
"\\u"
"\\U"
"\\N"
"\\_"
"\\L"
"\\P"
"\\0"
"\\e"
"\\\x0a"
# Byte order marks and special characters
"\xef\xbb\xbf"
"\xff\xfe"
"\xfe\xff"
"\xc2\x85"
"\xe2\x80\xa8"
"\xe2\x80\xa9"
"\xc2\xa0"
"\xed\xa0\x80"
"\xf0\x9f\x98\x80"
"\x00"
